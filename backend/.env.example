FLASK_ENV=development
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/actuarial_tutor
# Same Supabase project as DATABASE_URL's host -- used here only to verify
# Supabase Auth's JWKS-signed tokens (see app/services/supabase_auth_service.py),
# e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
OPENAI_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# ^ Langfuse Cloud has separate EU/US regions -- check Project Settings for
# your actual region's URL (e.g. https://us.cloud.langfuse.com) if traces
# aren't showing up.
VISION_MODEL=gpt-5.6-luna
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_P=
STRIPE_PRICE_ID_FM=
STRIPE_PRICE_ID_FAM=
FREE_TRIAL_TURNS=6
FRONTEND_URL=http://localhost:3000